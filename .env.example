# Backend
DATABASE_URL=sqlite:///./agrinox.db
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
NOMINATIM_USER_AGENT=Agrinox/0.1 (contact@example.com)
FRONTEND_ORIGIN=http://localhost:3000
# Optional: LAN URL the ESP32 can reach. Agrinox detects the computer's LAN IP when empty.
DEVICE_API_BASE_URL=
GEMINI_API_KEY=
PLANET_CLIENT_ID=
PLANET_CLIENT_SECRET=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Central event email notifications (use a provider app password, never a normal account password)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_POLL_SECONDS=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

